        "operating_policy": "/content/drive/MyDrive/Final Project DS23/Agentic AI-Assisted Detection of Musculoskeletal Abnormalities in Emergency X-rays/DATA/MODEL_B_FINE_TUNING/frozen_primary_operating_policy.json",
        "aggregation": "mean_probability",
        "input_resolution": [
            224,
            224
