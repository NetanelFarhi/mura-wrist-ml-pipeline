{
    "agent_name": "MURA Wrist Decision-Support Agent",
    "version": "1.2",
    "framework": "CrewAI",
    "llm_provider": "Google Gemini",
    "purpose": "Research-oriented orchestration of wrist radiograph classification, technical QC, anatomical scope validation, uncertainty analysis, explainability, and reporting.",
    "model": {
        "model_id": "canonical_model_b",
        "architecture": "ResNet18",
        "checkpoint": "/content/drive/MyDrive/Final Project DS23/Agentic AI-Assisted Detection of Musculoskeletal Abnormalities in Emergency X-rays/DATA/MODEL_B_FINE_TUNING/best_resnet18_study_level.pt",
        "selected_epoch": 9,
        "threshold": 0.263567715883255,
