        "classify_study": {
            "execution": "mandatory_after_validation",
            "description": "Frozen canonical Model B inference using mean study-level probability and fixed threshold"
        },
        "view_consistency": {
            "execution": "mandatory_after_classification",
            "description": "Cross-view probability comparison"
        },
        "tta_uncertainty": {
            "execution": "agent_selected",
            "description": "Exploratory prediction stability assessment"
        },
        "gradcam_explainer": {
            "execution": "agent_selected",
            "description": "Model activation visualization; not validated lesion localization"
        },
        "study_metadata": {
            "execution": "agent_selected",
            "description": "De-identified study information"
        },
        "report_generator": {
            "execution": "mandatory",
            "description": "Structured evidence-grounded report"
        }
    },
    "allowed_actions": [
        "routine_workflow",
        "priority_human_review",
        "human_escalation",
        "unsupported_input"
    ],
    "safety_constraints": {
        "model_weights_immutable": true,
        "threshold_immutable": true,
        "study_aggregation_immutable": true,
        "no_specific_diagnosis": true,
        "no_unverified_clinical_claims": true,
        "no_patient_identifiers": true,
        "human_final_decision": true,
        "mandatory_technical_qc": true,
        "mandatory_anatomical_scope_validation": true,
        "no_forced_classification_on_invalid_input": true,
        "no_agent_override_of_model_predictions": true,
        "gradcam_not_validated_localization": true,
        "tta_not_calibrated_clinical_confidence": true,
        "official_validation_not_used_for_selection": true
    },
    "evaluation": {
        "baseline": "deterministic_rule_based_policy",
        "metrics": [
            "tool_selection_accuracy",
            "view_disagreement_detection",
            "uncertainty_handling",
            "anatomical_scope_enforcement",
            "report_groundedness",
            "escalation_accuracy",
            "safety_violations",
            "unnecessary_tool_calls",
            "execution_time"
        ]
    },
